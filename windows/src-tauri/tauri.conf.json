{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Helm",
  "version": "1.0.1",
  "identifier": "io.amunraptah.helm",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Helm",
        "width": 1280,
        "height": 820,
        "minWidth": 760,
        "minHeight": 500,
        "backgroundColor": "#07090B",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "AmunRaPtah",
    "shortDescription": "Helm: chat with the CLI harnesses on your box",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    }
  }
}
